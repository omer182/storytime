PORT=3000

# LLM_PROVIDER selects which client to use: anthropic | openai | mock
# gpt-4.1 writes the stories: on the same prompt it follows the storytelling brief where gpt-4o
# ignores it, and it answers in ~10s where claude-sonnet-5 (better Hebrew still) takes ~60s.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1

# required - illustrations always go through OpenAI, and it writes the stories by default too
OPENAI_API_KEY=

# only needed when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# 3 illustrations per generated story, via OpenAI's image API - always OpenAI regardless of
# LLM_PROVIDER (Claude has no image generation), so this needs OPENAI_API_KEY set above.
# Set GENERATE_IMAGES=false to turn illustrations off.
GENERATE_IMAGES=true
IMAGE_MODEL=gpt-image-1.5
# low | medium | high - 'low' (the default) renders in about half the time and costs less per
# image; 'medium' gives a flatter, softer storybook look for more money and time.
IMAGE_QUALITY=low

# leave DB_PATH / FIGURES_PATH unset to use the built-in defaults
# (server/data/stories.db and server/src/data/figures.json)

# structured logs (pino) - every request, scan, figure enrollment, and LLM/image call with
# timing. LOG_LEVEL: trace | debug | info | warn | error | silent (debug also logs LLM token
# usage; silent is the default automatically when LLM_PROVIDER=mock, i.e. in tests)
LOG_LEVEL=info
LOG_PRETTY=true

